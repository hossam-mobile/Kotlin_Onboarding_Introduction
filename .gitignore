# .gitignore for Kotlin projects (Gradle/IntelliJ) with JavaScript/web examples

# Gradle
.gradle/
build/
**/build/

# Gradle wrapper - keep the properties but ignore the binary jar if you prefer; commonly the jar is tracked.
!gradle/wrapper/gradle-wrapper.properties

# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Kotlin
*.kotlin_module

# Java
*.class
*.jar
*.war
*.ear
*.nar

# Node / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp/
.pnp.js
dist/
coverage/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local environment files
.env
.env.*
local.properties

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Misc
.idea_modules/
*.keystore

# If you store generated documentation or reports
docs/generated/

# Lockfiles that might be regenerated by tools (optional)
# package-lock.json
# yarn.lock
